---
import { lpGutterInstallationReviews } from '../lib/lp-gutter-installation-reviews.js'
import { lpGutterRepairReviews } from '../lib/lp-gutter-repair-reviews.js'
import { CANONICAL_REVIEW_RATING_DISPLAY, reviewCountDisplay } from '../lib/review-count.js'
import { asStr, mediaUrl } from '../lib/sanity-strings.js'

const { settings = {}, homePage = {}, headline = 'See Why So Many Homeowners Choose Us', limit = 8 } = Astro.props
const reviews = settings?.reviews ?? homePage?.reviews ?? {}
const reviewsSummary = reviews?.summary ?? {}
const postedOn = asStr(reviews?.postedOnLabel) || 'Posted On Google'
const countLabel = reviewCountDisplay()

function plainText(value) {
  return String(value || '')
    .replace(/<[^>]+>/g, '')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;|&apos;/g, "'")
    .replace(/\s+/g, ' ')
    .trim()
}

function trimQuote(value, max = 180) {
  const plain = plainText(value)
  if (plain.length <= max) return plain
  const cut = plain.slice(0, max)
  const space = cut.lastIndexOf(' ')
  const base = (space > 110 ? cut.slice(0, space) : cut).replace(/[.,;:\s]+$/, '')
  return `${base}...`
}

const reviewAvatarSrc = (author, fallbackSrc) => {
  const name = asStr(author).toLowerCase()
  if (name.includes('alex witkowicz')) return '/Media%20(MHG)/Reviews%20(MHG)/responsive/alex-witkowicz-84.webp'
  if (name.includes('maximilian feeney')) return '/Media%20(MHG)/Reviews%20(MHG)/responsive/maximilian-feeney-84.webp'
  if (name.includes('michael tinker')) return '/Media%20(MHG)/Reviews%20(MHG)/responsive/michael-tinker-84.webp'
  if (name.includes('michael mccausey')) return '/Media%20(MHG)/Reviews%20(MHG)/responsive/michael-mccausey-84.webp'
  return mediaUrl(asStr(fallbackSrc))
}

const fromCms = (Array.isArray(reviews?.testimonials) ? reviews.testimonials : []).map((item) => ({
  author: asStr(item?.author),
  timeAgo: asStr(item?.timeAgo) || postedOn,
  avatarSrc: asStr(item?.avatarSrc),
  quote: trimQuote(item?.quote || item?.quoteHtml),
}))

const fromLp = [...lpGutterRepairReviews, ...lpGutterInstallationReviews].map((item) => ({
  author: asStr(item?.author),
  timeAgo: asStr(item?.timeAgo) || postedOn,
  avatarSrc: asStr(item?.avatarSrc),
  quote: trimQuote(item?.quoteHtml),
}))

const seen = new Set()
const testimonials = [...fromCms, ...fromLp]
  .filter((item) => {
    if (!item.quote || !item.author) return false
    const key = item.author.toLowerCase()
    if (seen.has(key)) return false
    seen.add(key)
    return true
  })
  .slice(0, Number(limit) > 0 ? Number(limit) : 8)
---

<section id="reviews" class="section google-reviews">
  <div class="container">
    <h2 class="section-title reviews-title">{headline}</h2>
    <div class="reviews-summary">
      <div class="reviews-summary-left">
        <p class="reviews-summary-brand">
          <img
            src="/Media%20(MHG)/Reviews%20(MHG)/responsive/google-icon-44.webp"
            alt={asStr(reviewsSummary?.brandLabel) || 'Google Reviews'}
            class="google-logo"
            width="44"
            height="44"
            loading="lazy"
            decoding="async"
          />
          <span>{asStr(reviewsSummary?.brandLabel) || 'Google Reviews'}</span>
        </p>
        <p class="reviews-summary-rating">
          <strong>{CANONICAL_REVIEW_RATING_DISPLAY}</strong>
          <img
            src="/Media%20(MHG)/Reviews%20(MHG)/responsive/stars-236.webp"
            alt={asStr(reviewsSummary?.starsImageAlt) || '5 Star Rating'}
            class="review-stars review-stars-inline"
            width="236"
            height="59"
            loading="lazy"
            decoding="async"
          />
          <span>{countLabel}</span>
        </p>
      </div>
    </div>
    <div class="testimonials-grid">
      {
        testimonials.map((item) => (
          <blockquote class="testimonial">
            <div class="review-brand review-brand-top">
              <img
                src={reviewAvatarSrc(item.author, item.avatarSrc)}
                alt={item.author}
                class="review-avatar"
                width="84"
                height="84"
                loading="lazy"
                decoding="async"
              />
              <div class="review-meta">
                <strong>{item.author}</strong>
                <span class="review-time">{item.timeAgo}</span>
              </div>
            </div>
            <img
              src="/Media%20(MHG)/Reviews%20(MHG)/responsive/stars-236.webp"
              alt={asStr(reviewsSummary?.starsImageAlt) || '5 Star Rating'}
              class="review-stars"
              width="236"
              height="59"
              loading="lazy"
              decoding="async"
            />
            <p>&quot;{item.quote}&quot;</p>
            <div class="review-posted-on">
              <img
                src="/Media%20(MHG)/Reviews%20(MHG)/responsive/google-icon-44.webp"
                alt={asStr(reviewsSummary?.brandLabel) || 'Google Reviews'}
                class="google-logo"
                width="44"
                height="44"
                loading="lazy"
                decoding="async"
              />
              <span>{postedOn}</span>
            </div>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>
