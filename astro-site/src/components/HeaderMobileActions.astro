---
/**
 * Mobile-only call icon + hamburger, shown next to each other in the header.
 */
interface Props {
  phoneTel: string
  phoneDisplay: string
}

const { phoneTel, phoneDisplay } = Astro.props
const tel = String(phoneTel || '').replace(/\s/g, '')
const label = `Call ${phoneDisplay || ''}`.trim()
---

<div class="header-mobile-actions">
  <a class="header-call-btn" href={`tel:${tel}`} aria-label={label}>
    <svg class="header-call-btn-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path
        d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
        fill="currentColor"
      />
    </svg>
  </a>
  <button class="nav-toggle" aria-label="Open Menu">
    <span></span><span></span><span></span>
  </button>
</div>
