---
/**
 * Hidden Ads attribution fields on every lead form.
 * Filled from cookie/localStorage by attribution.js on load and again on submit.
 * Never invent a GCLID — values stay empty unless the visitor arrived with them.
 */
---

<div class="lead-form-attribution" hidden>
  <input type="hidden" name="gclid" value="" autocomplete="off" />
  <input type="hidden" name="gbraid" value="" autocomplete="off" />
  <input type="hidden" name="wbraid" value="" autocomplete="off" />
  <input type="hidden" name="utm_source" value="" autocomplete="off" />
  <input type="hidden" name="utm_medium" value="" autocomplete="off" />
  <input type="hidden" name="utm_campaign" value="" autocomplete="off" />
  <input type="hidden" name="utm_term" value="" autocomplete="off" />
  <input type="hidden" name="utm_content" value="" autocomplete="off" />
  <input type="hidden" name="utm_id" value="" autocomplete="off" />
  <input type="hidden" name="landing_page" value="" autocomplete="off" />
  <input type="hidden" name="signup_page" value="" autocomplete="off" />
  <input type="hidden" name="first_page" value="" autocomplete="off" />
  <input type="hidden" name="firstLandingUrl" value="" autocomplete="off" />
  <input type="hidden" name="first_landing_at" value="" autocomplete="off" />
  <input type="hidden" name="firstLandingAt" value="" autocomplete="off" />
  <input type="hidden" name="referrer" value="" autocomplete="off" />
  <input type="hidden" name="firstReferrer" value="" autocomplete="off" />
</div>
