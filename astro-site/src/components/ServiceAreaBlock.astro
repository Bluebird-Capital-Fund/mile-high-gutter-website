---
import { asStr } from '../lib/sanity-strings.js'
import { SERVICE_AREA_CITIES, SERVICE_AREA_COUNTIES, SERVICE_AREA_INTRO } from '../lib/service-area-cities.js'

interface Props {
  id?: string
  eyebrow?: string
  headline?: string
  intro?: string
  introHtml?: string
  mapEmbedUrl?: string
  mapTitle?: string
  citiesLabel?: string
  showCounties?: boolean
  headingLevel?: 'h1' | 'h2'
}

const {
  id = 'service-area',
  eyebrow = 'Service Area',
  headline = 'Rain Gutters in the Denver Metro Area',
  intro = SERVICE_AREA_INTRO,
  introHtml = '',
  mapEmbedUrl = '',
  mapTitle = 'Service area map',
  citiesLabel = 'Cities We Serve',
  showCounties = false,
  headingLevel = 'h2',
} = Astro.props
const Heading = headingLevel === 'h1' ? 'h1' : 'h2'
const introMarkup = asStr(introHtml)
---

<section class="section service-area" id={id}>
  <div class="container">
    {asStr(eyebrow) ? <div class="why-eyebrow">{asStr(eyebrow)}</div> : null}
    <Heading class="section-title">{asStr(headline)}</Heading>
    {introMarkup ? (
      <p class="section-lead service-area-intro" set:html={introMarkup} />
    ) : (
      <p class="section-lead service-area-intro">{asStr(intro) || SERVICE_AREA_INTRO}</p>
    )}
    <div class="map-wrap">
      {asStr(mapEmbedUrl) ? (
        <iframe
          src={asStr(mapEmbedUrl)}
          width="600"
          height="400"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={asStr(mapTitle) || 'Service area map'}
        ></iframe>
      ) : null}
    </div>
    <div class="service-area-city-box">
      {showCounties ? (
        <>
          <p class="service-area-group-label">Counties</p>
          <p class="service-area-county-list">{SERVICE_AREA_COUNTIES.join(' - ')}</p>
          <p class="service-area-group-label">Communities We Serve</p>
        </>
      ) : null}
      <nav class="service-area-city-buttons" aria-label="Gutter services by city">
        {SERVICE_AREA_CITIES.map((city) => (
          <a href={city.href} class="service-area-city-btn">{city.name}</a>
        ))}
      </nav>
    </div>
  </div>
</section>
