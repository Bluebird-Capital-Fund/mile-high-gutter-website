---
/**
 * Shared LP hero proof points.
 * Asterisk-wrapped phrases render as bold; trailing (*) remains a warranty marker.
 */
interface Props {
  servicesLabel?: string
}

const { servicesLabel = 'Complete gutter services' } = Astro.props
---

<ul class="hero-lead hero-lead-list">
  <li><strong>10,000+</strong> projects completed</li>
  <li><strong>42+ years</strong> serving the Denver Metro Area</li>
  <li><strong>4.8-star rating</strong> from <strong>200+ Google reviews</strong></li>
  <li><strong>{servicesLabel}</strong> from one experienced team</li>
  <li><strong>Lifetime warranty options</strong> available*</li>
  <li><strong>Financing</strong> available for qualifying projects</li>
  <li><strong>Clear estimates</strong> with fast, clean service</li>
</ul>
