---
import { asStr } from '../lib/sanity-strings.js'

/**
 * Bottom bar: warranty/financing/SMS disclaimers, then copyright + legal links
 * (Privacy Policy, Terms of Service, Brightbeam SEO) like the NTG footer.
 * @param {object} props
 * @param {object} [props.footerSupport] — from site settings / home page
 * @param {string} props.copyrightHref
 * @param {string} props.companyName
 * @param {string} [props.copyrightInnerHtml] — sanitized HTML for homepage (uses copyrightTemplate); omit for standard © line
 */
const { footerSupport = {}, copyrightHref, companyName, copyrightInnerHtml } = Astro.props

const rawLinks = Array.isArray(footerSupport?.links) ? footerSupport.links : []

function linkKey(label) {
  return asStr(label).trim().toLowerCase()
}

const byKey = new Map()
for (const link of rawLinks) {
  const k = linkKey(link.label)
  if (k) byKey.set(k, link)
}

const requiredLinks = [
  { label: 'Privacy Policy', href: '/privacy-policy/' },
  { label: 'Terms of Service', href: '/terms-of-service/' },
  { label: 'Brightbeam SEO', href: 'https://brightbeamseo.com/', target: '_blank', rel: 'noopener noreferrer' },
]

const usedKeys = new Set()
const links = requiredLinks.map((fallback) => {
  const existing =
    byKey.get(linkKey(fallback.label)) ||
    (fallback.label === 'Terms of Service' ? byKey.get('terms of use') : undefined)
  const key = linkKey(existing?.label || fallback.label)
  usedKeys.add(key)
  if (existing) {
    const href = asStr(existing.href)
    return {
      ...fallback,
      ...existing,
      label: asStr(existing.label) || fallback.label,
      href: href && href !== '#' ? href : fallback.href,
      target: asStr(existing.target) || fallback.target,
      rel: asStr(existing.rel) || fallback.rel,
    }
  }
  return fallback
})

for (const link of rawLinks) {
  const k = linkKey(link.label)
  if (!k || usedKeys.has(k)) continue
  usedKeys.add(k)
  links.push(link)
}

const aria = asStr(footerSupport?.ariaLabel) || 'Footer legal links'
const license = asStr(footerSupport?.licenseNumber).trim() || '016436'
const useTemplate = typeof copyrightInnerHtml === 'string' && copyrightInnerHtml.length > 0
---

<div class="footer-support">
  <div class="container footer-disclaimers">
    <p class="footer-disclaimer">
      *The cost of lifetime warranty options varies based on the project, home size, and other important factors. Mile
      High Gutter offers lifetime warranty options and other valuable benefits to help keep your gutters performing
      properly for years to come. All gutter installation and repair projects include a standard 1-year workmanship
      warranty. Talk to your sales representative or contact us for more information.
    </p>
    <p class="footer-disclaimer">
      **Financing available with approved credit. Financing options, rates, terms, and promotional offers are subject
      to lender approval and may vary. See our <a href="/financing/">Financing page</a> for complete details,
      current offers, terms, and conditions.
    </p>
    <p class="footer-disclaimer">
      By providing your phone number, you agree to receive SMS messages from Mile High Gutter (Bluebird Denver LLC).
      Message frequency varies. Msg &amp; data rates may apply. Reply STOP to opt out. We do not sell or share your
      information with third parties for marketing purposes.
    </p>
  </div>
  <div class="footer-support-bar">
    <div class="container footer-support-inner">
      <div class="footer-support-lead">
        {
          useTemplate ? (
            <p>
              <a href={copyrightHref} set:html={copyrightInnerHtml} />
            </p>
          ) : (
            <p>
              © <span id="year"></span> — <a href={copyrightHref}>{companyName}</a>
            </p>
          )
        }
        <p class="footer-license">License Number — {license}</p>
      </div>
      <nav aria-label={aria}>
        {
          links.map((link) => (
            <a href={asStr(link.href)} target={asStr(link.target) || undefined} rel={asStr(link.rel) || undefined}>
              {asStr(link.label)}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</div>
