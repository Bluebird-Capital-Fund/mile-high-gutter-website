---
import StandardPageChrome from '../../components/StandardPageChrome.astro'
import FinancingPageOffers from '../../components/FinancingPageOffers.astro'
import { getSiteSettings } from '../../lib/site-settings.js'
import { asStr, mediaUrl } from '../../lib/sanity-strings.js'
import { heroBackgroundFor } from '../../lib/hero-backgrounds.js'
import { PAGE_COPY } from '../../lib/financing.js'

const settings = await getSiteSettings()
const phoneTel = asStr(settings?.business?.phoneTel)
const telHref = phoneTel ? `tel:${phoneTel}` : '#contact'
const heroBgSrc = heroBackgroundFor('financing')
const heroBgStyle = heroBgSrc
  ? `background-image: linear-gradient(135deg, rgba(56, 69, 85, 0.88) 0%, rgba(56, 69, 85, 0.84) 50%, rgba(56, 69, 85, 0.88) 100%), url("${mediaUrl(heroBgSrc)}"); background-size: cover; background-position: center; background-repeat: no-repeat;`
  : undefined
---

<StandardPageChrome
  title={PAGE_COPY.metaTitle}
  description={PAGE_COPY.metaDescription}
  navDdPrefix="financing"
>
  <main>
    <section class="hero hero-split financing-page-hero">
      <div class="hero-bg" style={heroBgStyle}></div>
      <div class="container hero-split-inner">
        <div class="hero-copy financing-page-hero-copy">
          <div class="hero-eyebrow">{PAGE_COPY.heroEyebrow}</div>
          <h1>{PAGE_COPY.heroHeadline}</h1>
          <p class="hero-lead">{PAGE_COPY.heroLead}</p>
          <div class="hero-actions">
            <a href={telHref} class="btn btn-primary btn-lg cta1-primary-call">{PAGE_COPY.ctaText}</a>
          </div>
        </div>
      </div>
    </section>

    <FinancingPageOffers />
  </main>
</StandardPageChrome>
