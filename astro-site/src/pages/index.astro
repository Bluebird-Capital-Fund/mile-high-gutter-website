    line3: 'Across the Denver Metro.',
  },
}
const whyStamp = whyChoose?.stamp
const whyCtas = whyChoose?.ctas
const services = {
  ...hp.services,
  headline: 'Our Gutter Services in Denver',
  items: [
    {
      number: '01',
      title: 'Gutter Installation',
      description:
        'Quality gutter systems designed for your property to manage Colorado rain and snowmelt and direct water safely away from your home.',
    },
    {
      number: '02',
      title: 'Gutter Repair',
      description:
        'We identify the cause of leaks, poor drainage, and failing sections, then recommend the right repair to restore proper water flow.',
    },
    {
      number: '03',
      title: 'Gutter Cleaning',
      description:
        'Professional cleaning removes leaves, debris, and buildup to help prevent clogs, overflow, and unnecessary wear on your gutter system.',
    },
    {
      number: '04',
      title: 'Gutter Guards',
      description:
        'Keep leaves and debris out of your gutters, reduce recurring clogs, and help your system drain properly with professionally installed gutter guards.',
    },
    {
      number: '05',
      title: 'French Drains',
      description:
        'Improve drainage around your property with a French drain system designed to redirect excess water away from foundations, landscaping, and other problem areas.',
