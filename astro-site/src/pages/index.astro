}
const about = {
  ...hp.about,
  headline: 'Trusted Gutter Contractors in Denver',
  lead:
    'Our experienced gutter contractors in Denver provide reliable solutions backed by 40+ years of local experience and a focus on long-term property protection.',
  bullets: [
    'Honest Recommendations: Knowledgeable estimators help you choose the right solution for your property without unnecessary upselling.',
    'Quality Workmanship: Durable gutter installation, repair, cleaning, guards, and drainage solutions built for long-term performance.',
    'Clear Communication: Straightforward estimates and dependable communication from consultation through project completion.',
  ],
}
const aboutVideo = about?.video
const aboutVideoSource = asStr(aboutVideo?.sourceSrc).trim().toLowerCase()
const aboutVideoPosterOnly =
  aboutVideoSource === 'poster-only' || aboutVideoSource === 'none'
const uniquePoints = {
  ...hp.uniquePoints,
  headline: 'Why Choose Our Denver Gutter Company?',
  items: [
    {
      iconId: 'clock',
      title: '40+ Years of Experience',
      description:
        'We have served the Denver metro since 1984. Our decades of local experience help us recommend gutter solutions suited to Colorado properties and weather.',
    },
    {
      iconId: 'clipboard',
      title: 'Honest Recommendations',
      description:
        'Our knowledgeable estimators focus on what your property actually needs. We explain your options clearly without pushing unnecessary work.',
    },
    {
      iconId: 'shield-check',
      title: 'Quality Workmanship',
      description:
        'We focus on careful installation and dependable workmanship on every project. Our goal is to provide durable gutter and drainage solutions that deliver long-term value.',
    },
    {
      iconId: 'message',
      title: 'Clear Communication',
      description:
        'We keep you informed throughout the estimate, scheduling, and installation process. You will know what to expect and what comes next.',
    },
    {
      iconId: 'sparkle',
      title: 'Long-Term Value',
      description:
        'We recommend solutions that improve drainage and help protect your property from water-related damage. The goal is to address the problem properly and help you avoid unnecessary costs over time.',
    },
    {
      iconId: 'package',
      title: 'Proven Local Experience',
      description:
        'Mile High Gutter has completed more than 10,000 projects across the Denver metro. Homeowners and businesses rely on our team for knowledgeable service and dependable gutter solutions.',
