---
import BaseLayout from '../../layouts/BaseLayout.astro'
import FooterSocialIcon from '../../components/FooterSocialIcon.astro'
import FooterHoursRow from '../../components/FooterHoursRow.astro'
import FooterContactInfo from '../../components/FooterContactInfo.astro'
import LeadFormSmsConsent from '../../components/LeadFormSmsConsent.astro'
import OfferBarMessage from '../../components/OfferBarMessage.astro'
import FooterSupportBar from '../../components/FooterSupportBar.astro'
import { googleBusinessProfileUrl, isContactFooterColumnHeading } from '../../lib/footer-contact-heading.js'
import { GROQ_HOME_PAGE, sanity } from '../../lib/sanity.js'
import { getSiteSettings, mergeHeaderFromSettings } from '../../lib/site-settings.js'
import { heroBackgroundFor } from '../../lib/hero-backgrounds.js'
import { asStr, applyTemplate, mediaUrl } from '../../lib/sanity-strings.js'
import { sanitizeCmsHtml } from '../../lib/sanitize-cms-html.js'
import { lpGutterGuardsReviews } from '../../lib/lp-gutter-guards-reviews.js'
import { lpGutterInstallationReviews } from '../../lib/lp-gutter-installation-reviews.js'
import { lpGutterRepairReviews } from '../../lib/lp-gutter-repair-reviews.js'

let settings = {}
let homePage = {}
let reviewsPage = {}
try {
  ;[settings, homePage, reviewsPage] = await Promise.all([
    getSiteSettings(),
    sanity.fetch(GROQ_HOME_PAGE),
    sanity.fetch(`*[_type == "reviewsPage" && slug.current == "reviews"][0]`),
  ])
} catch (err) {
  console.warn('[reviews] Sanity fetch failed; using fallback placeholders.', err)
}

const business = settings?.business ?? {}
const header = mergeHeaderFromSettings(settings, homePage?.header)
const footerEstimate = settings?.footerEstimate ?? homePage?.footerEstimate ?? {}
const footerEstimateFields = footerEstimate?.formFields ?? {}
const formsCfg = settings?.forms ?? {}
const footerBrand = settings?.footerBrand ?? homePage?.footerBrand ?? {}
const footerColumns = settings?.footerColumns ?? homePage?.footerColumns ?? []
const footerSupport = settings?.footerSupport ?? homePage?.footerSupport ?? {}

const companyName = asStr(business.companyName) || 'Mile High Gutters'
const phoneDisplay = asStr(business.phoneDisplay) || '(303) 000-0000'
const phoneTel = asStr(business.phoneTel) || '3030000000'
const email = asStr(business.email) || 'hello@example.com'
const address = asStr(business.addressShort) || 'Denver, Colorado'
const addressHref = googleBusinessProfileUrl(settings)
const descriptionShort = asStr(business.descriptionShort)
const logoWhite = asStr(business.logoHorizontalWhite)
const logoBlack = asStr(business.logoHorizontalBlack)
const copyrightHref = asStr(business.copyrightSiteUrl) || '#'

const callLabelNav = applyTemplate(asStr(header.callCtaTemplate), { phoneDisplay }) || phoneDisplay
const heroCallLabel = applyTemplate(asStr(homePage?.hero?.callCtaTemplate), { phoneDisplay }) || `Call: ${phoneDisplay}`
const logoAriaLabel = applyTemplate(asStr(header.logoAriaLabelTemplate), { companyName }) || companyName
const navItems = Array.isArray(header.navItems) ? header.navItems : []

const pageTitle = asStr(reviewsPage?.headline) || 'Reviews | Mile High Gutters'
const pageDescription = asStr(reviewsPage?.lead) || 'Customer reviews from Mile High Gutters.'
const heroEyebrow = asStr(reviewsPage?.eyebrow) || 'Reviews'
const heroHeadline = asStr(reviewsPage?.headline) || 'Customer Reviews'
const heroLead = asStr(reviewsPage?.lead) || 'See what homeowners and businesses say about our gutter services.'
const heroBgSrc = heroBackgroundFor('reviews')
const heroBgStyle = heroBgSrc
  ? `background-image: linear-gradient(135deg, rgba(56, 69, 85, 0.88) 0%, rgba(56, 69, 85, 0.84) 50%, rgba(56, 69, 85, 0.88) 100%), url("${mediaUrl(heroBgSrc)}"); background-size: cover; background-position: center; background-repeat: no-repeat;`
  : undefined

const reviewsData = settings?.reviews ?? reviewsPage?.reviews ?? homePage?.reviews ?? {}
const reviewSummary = reviewsData?.summary ?? {}
const existingTestimonials = Array.isArray(reviewsData?.testimonials) ? reviewsData.testimonials : []
const seenAuthors = new Set(
  existingTestimonials.map((t) => asStr(t?.author).trim().toLowerCase()).filter(Boolean),
)

function mapLpReview(t) {
  return {
    author: t.author,
    timeAgo: t.timeAgo,
    avatarSrc: t.avatarSrc,
    quote: t.quoteHtml,
    quoteHtml: t.quoteHtml,
  }
}

function takeNewLpReviews(list) {
  const out = []
  for (const t of list) {
    const key = asStr(t.author).trim().toLowerCase()
    if (!key || seenAuthors.has(key)) continue
    seenAuthors.add(key)
    out.push(mapLpReview(t))
  }
  return out
}

const gutterGuardsTestimonials = takeNewLpReviews(lpGutterGuardsReviews)
const gutterInstallationTestimonials = takeNewLpReviews(lpGutterInstallationReviews)
const gutterRepairTestimonials = takeNewLpReviews(lpGutterRepairReviews)
const testimonials = [
  ...existingTestimonials,
  ...gutterGuardsTestimonials,
  ...gutterInstallationTestimonials,
  ...gutterRepairTestimonials,
]

const universalFormFields = footerEstimateFields
const universalFormAction = asStr(formsCfg?.submitPath) || asStr(footerEstimate?.formAction) || '#'
const universalFormMethod = asStr(footerEstimate?.formMethod) || 'post'
const universalFormKicker = asStr(formsCfg?.formKicker) || 'Free Estimate'
const universalFormAriaLabel = asStr(formsCfg?.formAriaLabel) || 'Reviews lead form'
const universalFormHeading = asStr(footerEstimate?.headline) || 'Get Started Today'
const universalFormIntro = asStr(footerEstimate?.intro) || 'Short placeholder form for layout testing.'
const universalRequiredIndicator = asStr(formsCfg?.requiredIndicator) || '*'
---

<BaseLayout title={pageTitle} description={pageDescription} theme={settings?.theme} forms={{ submitPath: asStr(settings?.forms?.submitPath) || '/api/lead' }}>
  <header class="header">
    <div class="offer-bar"><div class="offer-bar-inner"><p class="offer-message"><OfferBarMessage offerBar={header?.offerBar} /></p></div></div>
    <div class="header-nav">
      <div class="header-inner">
        <a href="/" class="logo" aria-label={logoAriaLabel}>{logoBlack ? <img src={mediaUrl(logoBlack)} alt={companyName} class="logo-img" /> : <span class="section-title" style="margin:0; font-size: 1.25rem;">{companyName}</span>}</a>
        <button class="nav-toggle" aria-label="Open Menu">
          <span></span><span></span><span></span>
        </button>
        <nav class="nav">
          {navItems.length > 0 ? (
            navItems.map((item, i) => {
              const label = asStr(item.label)
              const href = asStr(item.href)
              const dropdown = item.dropdown
              if (Array.isArray(dropdown) && dropdown.length > 0) {
                const ddId = `reviews-nav-dd-${i}`
                return (
                  <div class="nav-dropdown" data-nav-dropdown>
                    <button
                      type="button"
                      class="nav-dropdown-toggle"
                      aria-expanded="false"
                      aria-haspopup="true"
                      aria-controls={ddId}
                      id={`${ddId}-btn`}
                    >
                      {label}
                      <span class="nav-dropdown-chevron" aria-hidden="true"></span>
                    </button>
                    <ul class="nav-dropdown-menu" id={ddId} role="menu">
                      {dropdown.map((link) => (
                        <li role="none">
                          <a href={asStr(link.href)} role="menuitem">
                            {asStr(link.label)}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              }
              return <a href={href || '#'}>{label}</a>
            })
          ) : (
            <>
              <a href="/">Home</a>
              <a href="/products-services/">Products & Services</a>
            </>
          )}
          <a href={`tel:${phoneTel}`} class="btn btn-primary btn-lg">{callLabelNav}</a>
        </nav>
      </div>
    </div>
  </header>

  <main>
    <section class="hero hero-split">
      <div class="hero-bg" style={heroBgStyle}></div>
      <div class="container hero-split-inner">
        <div class="hero-copy">
          <div class="hero-eyebrow">{heroEyebrow}</div>
          <h1>{heroHeadline}</h1>
          <p class="hero-lead">{heroLead}</p>
          <div class="hero-actions"><a href={`tel:${phoneTel}`} class="btn btn-primary btn-lg cta1-primary-call">{heroCallLabel}</a></div>
        </div>
        <form class="hero-form" data-lead-form="reviews-hero" action={universalFormAction} method={universalFormMethod} aria-label={universalFormAriaLabel}>
          <div class="hero-form-heading"><div class="hero-form-kicker">{universalFormKicker}</div><h2>{universalFormHeading}</h2></div>
          <p class="hero-form-sub">{universalFormIntro}</p>
          <div class="hero-form-grid">
            <div class="hero-form-field">
              <label for="reviews-first-name">
                First Name{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input id="reviews-first-name" name="firstName" type="text" required autocomplete="given-name" />
            </div>
            <div class="hero-form-field">
              <label for="reviews-last-name">
                Last Name{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input id="reviews-last-name" name="lastName" type="text" required autocomplete="family-name" />
            </div>
            <div class="hero-form-field">
              <label for="reviews-email">
                {asStr(universalFormFields?.emailLabel) || 'Email'}{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input id="reviews-email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="hero-form-field">
              <label for="reviews-phone">
                {asStr(universalFormFields?.phoneLabel) || 'Phone'}{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input
                id="reviews-phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                maxlength="12"
                inputmode="numeric"
                pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}"
                title="10-digit phone, e.g. 303-762-9841"
              />
            </div>
            <div class="hero-form-field hero-form-field-full">
              <label for="reviews-address">Address</label>
              <input
                id="reviews-address"
                name="address"
                type="text"
                autocomplete="street-address"
                spellcheck="false"
              />
            </div>
            <div class="hero-form-field hero-form-field-full">
              <label for="reviews-message">{asStr(universalFormFields?.projectDetailsLabel) || 'Project Details'}</label>
              <textarea id="reviews-message" name="message" rows="3"></textarea>
            </div>
          </div>
          <LeadFormSmsConsent idPrefix="reviews" variant="hero" />
          <button type="submit" class="btn btn-primary btn-lg">{asStr(universalFormFields?.submitButton) || 'Send'}</button>
        </form>
      </div>
    </section>

    <section class="section google-reviews reviews-page-list">
      <div class="container">
        <h2 class="section-title reviews-title">{asStr(reviewsData?.headline) || 'Customer Reviews'}</h2>
        <div class="reviews-summary">
          <div class="reviews-summary-left">
            <p class="reviews-summary-brand">
              <img src={mediaUrl(asStr(reviewSummary?.googleIconSrc))} alt={asStr(reviewSummary?.brandLabel)} class="google-logo" />
              <span>{asStr(reviewSummary?.brandLabel)}</span>
            </p>
          </div>
        </div>
        <div class="testimonials-grid">
          {(testimonials.length > 0 ? testimonials : []).map((t) => {
            const quoteHtml = asStr(t.quoteHtml)
            const quotePlain = asStr(t.quote)
            const renderedQuote = quoteHtml
              ? sanitizeCmsHtml(quoteHtml)
              : quotePlain
            return (
            <blockquote class="testimonial">
              <div class="review-brand review-brand-top">
                <img src={mediaUrl(asStr(t.avatarSrc))} alt={asStr(t.author)} class="review-avatar" />
                <div class="review-meta">
                  <strong>{asStr(t.author)}</strong>
                  {asStr(t.timeAgo) ? <span class="review-time">{asStr(t.timeAgo)}</span> : null}
                </div>
              </div>
              <img src={mediaUrl(asStr(reviewSummary?.starsImageSrc))} alt={asStr(reviewSummary?.starsImageAlt)} class="review-stars" />
              {quoteHtml ? (
                <p class="review-quote" set:html={`&quot;${renderedQuote}&quot;`} />
              ) : (
                <p class="review-quote">&quot;{quotePlain}&quot;</p>
              )}
            </blockquote>
            )
          })}
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <section id="contact" class="section contact footer-estimate">
      <div class="container">
        <div class="contact-wrapper">
          <div class="contact-info">
            <h2 class="section-title">{asStr(footerEstimate?.headline) || 'Need Gutter Help in Denver?'}</h2>
            <p>{asStr(footerEstimate?.intro) || 'Contact us for fast service and straightforward estimates.'}</p>
            <FooterContactInfo variant="estimate" phoneTel={phoneTel} phoneDisplay={phoneDisplay} email={email} address={address} />
          </div>
          <form class="contact-form" data-lead-form="reviews-footer" action={universalFormAction} method={universalFormMethod}>
            <div class="contact-form-grid">
              <div class="contact-form-field">
                <label for="reviews-contact-first-name">
                  First Name{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input id="reviews-contact-first-name" name="firstName" type="text" required autocomplete="given-name" />
              </div>
              <div class="contact-form-field">
                <label for="reviews-contact-last-name">
                  Last Name{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input id="reviews-contact-last-name" name="lastName" type="text" required autocomplete="family-name" />
              </div>
              <div class="contact-form-field">
                <label for="reviews-contact-email">
                  {asStr(universalFormFields?.emailLabel) || 'Email'}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input id="reviews-contact-email" name="email" type="email" required autocomplete="email" />
              </div>
              <div class="contact-form-field">
                <label for="reviews-contact-phone">
                  {asStr(universalFormFields?.phoneLabel) || 'Phone'}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input
                  id="reviews-contact-phone"
                  name="phone"
                  type="tel"
                  required
                  autocomplete="tel"
                  maxlength="12"
                  inputmode="numeric"
                  pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}"
                  title="10-digit phone, e.g. 303-762-9841"
                />
              </div>
              <div class="contact-form-field contact-form-field-full">
                <label for="reviews-contact-address">Address</label>
                <input
                  id="reviews-contact-address"
                  name="address"
                  type="text"
                  autocomplete="street-address"
                  spellcheck="false"
                />
              </div>
              <div class="contact-form-field contact-form-field-full">
                <label for="reviews-contact-message">{asStr(universalFormFields?.projectDetailsLabel) || 'Project Details'}</label>
                <textarea id="reviews-contact-message" name="message" rows="4"></textarea>
              </div>
            </div>
            <LeadFormSmsConsent idPrefix="reviews-footer" variant="contact" />
            <button type="submit" class="btn btn-primary btn-lg">{asStr(footerEstimateFields?.submitButton) || 'Request Quote'}</button>
          </form>
        </div>
      </div>
    </section>
    <div class="container"><div class="footer-inner"><div class="footer-brand-block footer-col">{logoWhite ? <img src={mediaUrl(logoWhite)} alt={companyName} class="footer-logo" /> : null}<p class="footer-address">{descriptionShort}</p><div class="footer-social" aria-label={asStr(footerBrand?.socialAriaLabel)}>{footerBrand?.socialLinks?.map((s) => (<a href={asStr(s.href)} aria-label={asStr(s.ariaLabel)}><FooterSocialIcon platform={asStr(s.platform)} /></a>))}</div></div>{footerColumns?.map((col) => (<div class="footer-col"><p class="footer-heading">{asStr(col.heading)}</p>{col.links?.length ? (<nav class="footer-links" aria-label={asStr(col.ariaLabel)}>{col.links.map((link) => (<a href={asStr(link.href)}>{asStr(link.label)}</a>))}</nav>) : null}{isContactFooterColumnHeading(col.heading) ? <FooterContactInfo variant="footer-column" phoneTel={phoneTel} phoneDisplay={phoneDisplay} email={email} address={address} addressHref={addressHref} /> : null}{col.hoursHeading ? <p class="footer-heading footer-hours-heading">{asStr(col.hoursHeading)}</p> : null}{col.hoursText ? <FooterHoursRow hoursText={col.hoursText} /> : null}</div>))}</div></div>
  </footer>

  <FooterSupportBar footerSupport={footerSupport} copyrightHref={copyrightHref} companyName={companyName} />
  <style is:global>
    .reviews-page-list .testimonial p.review-quote {
      font-style: normal;
      color: var(--color-text);
    }
    .reviews-page-list .testimonial p.review-quote strong,
    .reviews-page-list .testimonial p.review-quote b {
      color: #000;
      font-weight: 700;
      font-style: italic;
    }
    .reviews-page-list .testimonial p.review-quote em,
    .reviews-page-list .testimonial p.review-quote i {
      color: #000;
      font-style: italic;
      font-weight: 700;
    }
  </style>
</BaseLayout>
