---
import StandardPageChrome from '../../components/StandardPageChrome.astro'
import { sanity } from '../../lib/sanity.js'
import { getSiteSettings } from '../../lib/site-settings.js'
import { asStr } from '../../lib/sanity-strings.js'
import { cityServiceOverrideSlugs, getCityServiceOverride } from '../../lib/city-service-overrides/index.js'

let settings = {}
let pages = []
try {
  ;[settings, pages] = await Promise.all([
    getSiteSettings(),
    sanity.fetch(
      `*[_type == "cityServicePage" && defined(slug.current)]{title, headline, lead, "slug": slug.current} | order(title asc)`
    ),
  ])
} catch (err) {
  console.warn('[products-services/index] Sanity fetch failed.', err)
}

const pageTitle = 'Products & Services | Mile High Gutters'
const pageDescription = 'Explore gutter products and services in Denver.'
const SLUG_ALIASES = {
  'seamless-gutters-denver-co': 'seamless-gutter-denver-co',
  'gutter-guards-denver-co': 'denver-gutter-guards-co',
}
const fromSanity = (Array.isArray(pages) ? pages : []).map((item) => {
  const raw = asStr(item?.slug)
  return {
    ...item,
    slug: SLUG_ALIASES[raw] || raw,
  }
})
const sanitySlugs = new Set(fromSanity.map((item) => asStr(item.slug)))
const fromOverrides = cityServiceOverrideSlugs
  .filter((slug) => !sanitySlugs.has(slug))
  .map((slug) => {
    const override = getCityServiceOverride(slug)
    return {
      slug,
      title: asStr(override?.headline) || slug,
      headline: asStr(override?.headline),
      lead: asStr(override?.lead),
    }
  })
const items = [...fromSanity, ...fromOverrides].sort((a, b) =>
  asStr(a.title || a.headline).localeCompare(asStr(b.title || b.headline)),
)
const productsServicesIntro = asStr(settings?.productsServicesIntro)
---

<StandardPageChrome
  title={pageTitle}
  description={pageDescription}
  navDdPrefix="products"
>
  <main class="section">
    <div class="container">
      <h1 class="section-title section-title-secondary">Products & Services</h1>
      {productsServicesIntro ? <p class="section-lead" style="max-width: 70ch;">{productsServicesIntro}</p> : null}
      <div style="display:grid; gap:1rem; margin-top:1.5rem;">
        {items.length > 0 ? (
          items.map((item) => (
            <article style="padding:1rem 1.25rem; border:1px solid rgba(0,0,0,0.08); border-radius:12px;">
              <h2 style="margin:0 0 .5rem;">
                <a href={`/products-services/${asStr(item.slug)}/`}>
                  {asStr(item.title) || asStr(item.headline) || asStr(item.slug)}
                </a>
              </h2>
              <p style="margin:0; color:#4b5563;">{asStr(item.lead) || 'Content placeholder page. Update in Sanity.'}</p>
            </article>
          ))
        ) : (
          <p>No city service pages found yet in Sanity.</p>
        )}
      </div>
    </div>
  </main>
</StandardPageChrome>
