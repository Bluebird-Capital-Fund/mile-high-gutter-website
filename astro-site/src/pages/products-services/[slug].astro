---
import BaseLayout from '../../layouts/BaseLayout.astro'
import FooterSocialIcon from '../../components/FooterSocialIcon.astro'
import FooterContactInfo from '../../components/FooterContactInfo.astro'
import LeadFormSmsConsent from '../../components/LeadFormSmsConsent.astro'
import OfferBarMessage from '../../components/OfferBarMessage.astro'
import FooterSupportBar from '../../components/FooterSupportBar.astro'
import FooterHoursRow from '../../components/FooterHoursRow.astro'
import { googleBusinessProfileUrl, isContactFooterColumnHeading } from '../../lib/footer-contact-heading.js'
import { GROQ_HOME_PAGE, sanity } from '../../lib/sanity.js'
import { getSiteSettings, mergeHeaderFromSettings } from '../../lib/site-settings.js'
import { heroBackgroundFor } from '../../lib/hero-backgrounds.js'
import { getCityServiceOverride, cityServiceOverrideSlugs } from '../../lib/city-service-overrides/index.js'
import { sanitizeCmsHtml } from '../../lib/sanitize-cms-html.js'
import { asStr, applyTemplate, mediaUrl } from '../../lib/sanity-strings.js'

/** Old Sanity slugs superseded by newer URLs (redirected in vercel.json). */
const RETIRED_CITY_SERVICE_SLUGS = new Set([
  'seamless-gutters-denver-co',
  'gutter-guards-denver-co',
  'soffit-fascia-repair-denver-co',
  'downspouts-denver-co',
])

export async function getStaticPaths() {
  try {
    const pages = await sanity.fetch(
      `*[_type == "cityServicePage" && defined(slug.current)]{"slug": slug.current}`
    )
    const fromSanity = (Array.isArray(pages) ? pages : [])
      .map((p) => asStr(p?.slug))
      .filter((slug) => slug && !RETIRED_CITY_SERVICE_SLUGS.has(slug))
    const slugs = [...new Set([...fromSanity, ...cityServiceOverrideSlugs])]
    return slugs.map((slug) => ({ params: { slug } }))
  } catch (err) {
    console.warn('[products-services/[slug]] Failed to load city service slugs.', err)
    return cityServiceOverrideSlugs.map((slug) => ({ params: { slug } }))
  }
}

const slug = asStr(Astro.params?.slug)
const pageOverride = getCityServiceOverride(slug)
const pageDescription =
  asStr(pageOverride?.pageDescription) ||
  'Professional gutter services in Denver with fast scheduling and quality workmanship.'

let settings = {}
let homePage = {}
let cityPage = {}
try {
  ;[settings, homePage, cityPage] = await Promise.all([
    getSiteSettings(),
    sanity.fetch(GROQ_HOME_PAGE),
    sanity.fetch(`*[_type == "cityServicePage" && slug.current == $slug][0]`, { slug }),
  ])
} catch (err) {
  console.warn(`[products-services/${slug}] Sanity fetch failed; using fallback placeholders.`, err)
}

const business = settings?.business ?? {}
const header = mergeHeaderFromSettings(settings, homePage?.header)
const hero = homePage?.hero ?? {}
const services = homePage?.services ?? {}
const faq = pageOverride?.faq ?? cityPage?.faq ?? homePage?.faq ?? {}
const footerEstimate = settings?.footerEstimate ?? homePage?.footerEstimate ?? {}
const footerEstimateFields = footerEstimate?.formFields ?? {}
const formsCfg = settings?.forms ?? {}
const footerBrand = settings?.footerBrand ?? homePage?.footerBrand ?? {}
const footerColumns = settings?.footerColumns ?? homePage?.footerColumns ?? []
const footerSupport = settings?.footerSupport ?? homePage?.footerSupport ?? {}
const serviceArea = homePage?.serviceArea ?? {}

const companyName = asStr(business.companyName) || 'Mile High Gutters'
const phoneDisplay = asStr(business.phoneDisplay) || '(303) 000-0000'
const phoneTel = asStr(business.phoneTel) || '3030000000'
const email = asStr(business.email) || 'hello@example.com'
const address = asStr(business.addressShort) || 'Denver, Colorado'
const addressHref = googleBusinessProfileUrl(settings)
const descriptionShort = asStr(business.descriptionShort)
const logoWhite = asStr(business.logoHorizontalWhite)
const copyrightHref = asStr(business.copyrightSiteUrl) || '#'
const logoBlack = asStr(business.logoHorizontalBlack)

const callLabelNav = applyTemplate(asStr(header.callCtaTemplate), { phoneDisplay }) || phoneDisplay
const logoAriaLabel = applyTemplate(asStr(header.logoAriaLabelTemplate), { companyName }) || companyName
const navItems = Array.isArray(header.navItems) ? header.navItems : []
const heroCallLabel = applyTemplate(asStr(hero?.callCtaTemplate), { phoneDisplay }) || `Call ${phoneDisplay}`
const universalFormFields = footerEstimateFields
const universalFormAction = asStr(formsCfg?.submitPath) || asStr(footerEstimate?.formAction) || '#'
const universalFormMethod = asStr(footerEstimate?.formMethod) || 'post'
const universalFormKicker = asStr(formsCfg?.formKicker) || 'Free Estimate'
const universalFormAriaLabel = asStr(formsCfg?.formAriaLabel) || 'City service lead form'
const universalRequiredIndicator = asStr(formsCfg?.requiredIndicator) || '*'
const universalFormHeading = asStr(footerEstimate?.headline) || 'Get Started Today'
const universalFormIntro = asStr(footerEstimate?.intro) || 'Short placeholder form for layout testing.'
const heroBgSrc = asStr(cityPage?.layoutBackgrounds?.hero?.imageSrc) || heroBackgroundFor(`service-${slug}`)
const servicesBgSrc = asStr(cityPage?.layoutBackgrounds?.services?.imageSrc)
const heroBgStyle = heroBgSrc
  ? `background-image: linear-gradient(135deg, rgba(56, 69, 85, 0.88) 0%, rgba(56, 69, 85, 0.84) 50%, rgba(56, 69, 85, 0.88) 100%), url("${mediaUrl(heroBgSrc)}"); background-size: cover; background-position: center; background-repeat: no-repeat;`
  : undefined
const servicesBgStyle = servicesBgSrc
  ? `background-color: #143980; background-image: linear-gradient(135deg, rgba(20, 57, 128, 0.94) 0%, rgba(26, 74, 158, 0.94) 100%), url("${mediaUrl(servicesBgSrc)}"); background-size: cover; background-position: center; background-repeat: no-repeat;`
  : undefined
const sharedReviews = settings?.reviews ?? homePage?.reviews ?? {}
const reviewsToRender = {
  ...sharedReviews,
  ...(pageOverride?.reviewsHeadline ? { headline: pageOverride.reviewsHeadline } : {}),
}
const cityContentSections = Array.isArray(pageOverride?.contentSections)
  ? pageOverride.contentSections
  : Array.isArray(cityPage?.contentSections)
    ? cityPage.contentSections
    : []
const mapEmbedUrl = asStr(cityPage?.mapEmbedUrl) || asStr(settings?.mapEmbedUrl)
const estimateCtaText = 'Book a Consultation'
const estimateCtaHref = '#contact'
const pageH1 = asStr(pageOverride?.headline) || asStr(cityPage?.headline) || asStr(hero?.headline) || 'Gutter Services in Denver, CO'
const pageTitle = asStr(pageOverride?.pageTitle) || `${pageH1} | Mile High Gutters`
const pageEyebrow = asStr(pageOverride?.eyebrow) || asStr(cityPage?.eyebrow) || asStr(hero?.eyebrow) || 'City Service'
const pageLead =
  asStr(pageOverride?.lead) ||
  asStr(cityPage?.lead) ||
  asStr(hero?.lead) ||
  'City service page starter connected to Sanity content.'
const hideServicesGrid = Boolean(pageOverride?.hideServicesGrid)
const showServiceAreaCities = Boolean(pageOverride?.showServiceAreaCities)
const midCta = pageOverride?.midCta || null
const canonicalHref = `https://www.milehighgutter.com/products-services/${slug}/`

const serviceHref = (svc) => {
  const explicit = asStr(svc?.href)
  if (explicit) return explicit
  const title = asStr(svc?.title).toLowerCase().trim()
  if (!title) return '/products-services/'
  const knownSlugs = {
    'gutter installation': 'gutter-installation-denver-co',
    'gutter repair': 'gutter-repair-denver-co',
    'gutter cleaning': 'gutter-cleaning-denver-co',
    'gutter maintenance': 'gutter-maintenance-denver-co',
    'gutter inspection': 'gutter-inspection-services-denver-co',
    'gutter inspection services': 'gutter-inspection-services-denver-co',
    'gutter guards': 'denver-gutter-guards-co',
    'denver gutter guards': 'denver-gutter-guards-co',
    'heated gutters': 'snow-ice-solutions-heat-tape-denver-co',
    'french drains': 'gutter-downspouts-denver-co',
    'downspouts': 'gutter-downspouts-denver-co',
    'gutter downspouts': 'gutter-downspouts-denver-co',
    'soffit & fascia': 'denver-fascia-soffit-repair-co',
    'soffit and fascia': 'denver-fascia-soffit-repair-co',
    'fascia and soffit': 'denver-fascia-soffit-repair-co',
    'fascia and soffit repair': 'denver-fascia-soffit-repair-co',
  }
  if (knownSlugs[title]) return `/products-services/${knownSlugs[title]}/`
  const generated = title
    .replace(/&/g, ' and ')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
  return `/products-services/${generated}-denver-co/`
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  theme={settings?.theme}
  forms={{ submitPath: asStr(settings?.forms?.submitPath) || '/api/lead' }}
  canonical={canonicalHref}
>
  <header class="header">
    <div class="offer-bar">
      <div class="offer-bar-inner">
        <p class="offer-message">
          <OfferBarMessage offerBar={header?.offerBar} />
        </p>
      </div>
    </div>
    <div class="header-nav">
      <div class="header-inner">
        <a href="/" class="logo" aria-label={logoAriaLabel}>
          {logoBlack ? (
            <img src={mediaUrl(logoBlack)} alt={companyName} class="logo-img" />
          ) : (
            <span class="section-title" style="margin:0; font-size: 1.25rem;">{companyName}</span>
          )}
        </a>
        <button class="nav-toggle" aria-label="Open Menu">
          <span></span><span></span><span></span>
        </button>
        <nav class="nav">
          {navItems.length > 0 ? (
            navItems.map((item, i) => {
              const label = asStr(item.label)
              const href = asStr(item.href)
              const dropdown = item.dropdown
              if (Array.isArray(dropdown) && dropdown.length > 0) {
                const ddId = `city-nav-dd-${i}`
                return (
                  <div class="nav-dropdown" data-nav-dropdown>
                    <button
                      type="button"
                      class="nav-dropdown-toggle"
                      aria-expanded="false"
                      aria-haspopup="true"
                      aria-controls={ddId}
                      id={`${ddId}-btn`}
                    >
                      {label}
                      <span class="nav-dropdown-chevron" aria-hidden="true"></span>
                    </button>
                    <ul class="nav-dropdown-menu" id={ddId} role="menu">
                      {dropdown.map((link) => (
                        <li role="none">
                          <a href={asStr(link.href)} role="menuitem">
                            {asStr(link.label)}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              }
              return <a href={href || '#'}>{label}</a>
            })
          ) : (
            <>
              <a href="/">Home</a>
              <a href="/products-services/">Products & Services</a>
            </>
          )}
          <a href={`tel:${phoneTel}`} class="btn btn-primary btn-lg">{callLabelNav}</a>
        </nav>
      </div>
    </div>
  </header>

  <main>
    <section class="hero hero-split">
      <div class="hero-bg" style={heroBgStyle}></div>
      <div class="container hero-split-inner">
        <div class="hero-copy">
          <div class="hero-eyebrow">{pageEyebrow}</div>
          <h1>{pageH1}</h1>
          <p class="hero-lead">{pageLead}</p>
          <div class="hero-actions">
            <a href={`tel:${phoneTel}`} class="btn btn-primary btn-lg cta1-primary-call">{heroCallLabel}</a>
          </div>
        </div>

        <form
          class="hero-form"
          data-lead-form="city-hero"
          action={universalFormAction}
          method={universalFormMethod}
          aria-label={universalFormAriaLabel}
        >
          <div class="hero-form-heading">
            <div class="hero-form-kicker">{universalFormKicker}</div>
            <h2>{universalFormHeading}</h2>
          </div>
          <p class="hero-form-sub">{universalFormIntro}</p>
          <div class="hero-form-grid">
            <div class="hero-form-field">
              <label for="city-hero-first-name">
                First Name{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input id="city-hero-first-name" name="firstName" type="text" required autocomplete="given-name" />
            </div>
            <div class="hero-form-field">
              <label for="city-hero-last-name">
                Last Name{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input id="city-hero-last-name" name="lastName" type="text" required autocomplete="family-name" />
            </div>
            <div class="hero-form-field">
              <label for="city-hero-email">
                {asStr(universalFormFields?.emailLabel) || 'Email'}{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input id="city-hero-email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="hero-form-field">
              <label for="city-hero-phone">
                {asStr(universalFormFields?.phoneLabel) || 'Phone'}{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input
                id="city-hero-phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                maxlength="12"
                inputmode="numeric"
                pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}"
                title="10-digit phone, e.g. 303-762-9841"
              />
            </div>
            <div class="hero-form-field hero-form-field-full">
              <label for="city-hero-address">Address</label>
              <input
                id="city-hero-address"
                name="address"
                type="text"
                autocomplete="street-address"
                spellcheck="false"
              />
            </div>
            <div class="hero-form-field hero-form-field-full">
              <label for="city-hero-message">{asStr(universalFormFields?.projectDetailsLabel) || 'Project Details'}</label>
              <textarea id="city-hero-message" name="message" rows="3"></textarea>
            </div>
          </div>
          <LeadFormSmsConsent idPrefix="city-hero" variant="hero" />
          <button type="submit" class="btn btn-primary btn-lg">Submit</button>
        </form>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <article style="max-width: 72ch; margin: 0 auto;">
          {(cityContentSections.length > 0
            ? cityContentSections
            : [
                {
                  heading: 'City-Specific Gutter Service Content',
                  body: 'Use this section for rich local service copy. Add one or more blocks in Sanity. Images are optional per block.',
                  showCta: true,
                },
              ]
          ).map((sec) => {
            const showCta = sec?.showCta !== false
            const imageSrc = asStr(sec.imageSrc)
            return (
              <>
                <h2 class="section-title section-title-secondary">{asStr(sec.heading)}</h2>
                <div
                  class="section-lead city-service-body"
                  style="max-width:72ch; margin-bottom: 1rem;"
                  set:html={sanitizeCmsHtml(asStr(sec.body))}
                />
                {imageSrc ? (
                  <img
                    src={mediaUrl(imageSrc)}
                    alt={asStr(sec.imageAlt) || asStr(sec.heading)}
                    style="width: 100%; height: auto; border-radius: 12px; margin: 0 0 1.75rem; display: block;"
                    loading="lazy"
                    decoding="async"
                  />
                ) : null}
                {showCta ? (
                  <div class="why-choose-actions" style="margin: 0 0 2.25rem;">
                    <a href={`tel:${phoneTel}`} class="btn btn-primary btn-lg">{heroCallLabel}</a>
                    <a href={estimateCtaHref} class="btn btn-outline btn-lg request-estimate">{estimateCtaText}</a>
                  </div>
                ) : (
                  <div style="margin: 0 0 2.25rem;"></div>
                )}
              </>
            )
          })}
        </article>
      </div>
    </section>

    {!hideServicesGrid ? (
    <section class="section services" style={servicesBgStyle}>
      <div class="container">
        <h2 class="section-title">{asStr(services?.headline) || 'Our Gutter Services in Denver'}</h2>
        <div class="services-grid">
          {(Array.isArray(services?.items) && services.items.length > 0
            ? services.items
            : [
                { number: '01', title: 'Gutter Installation', description: 'Placeholder text for service summary.' },
                { number: '02', title: 'Gutter Repair', description: 'Placeholder text for service summary.' },
                { number: '03', title: 'Gutter Guards', description: 'Placeholder text for service summary.' },
              ]
          ).map((svc) => (
            <article class="service-card">
              <a href={serviceHref(svc)} class="service-image-wrap" style="display:block; color:inherit; text-decoration:none;">
                <span class="service-number">{asStr(svc.number)}</span>
                <h3 class="service-title">{asStr(svc.title)}</h3>
                <p class="service-desc">{asStr(svc.description)}</p>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
    ) : null}

    <section class="section faq-section" id="faq">
      <div class="container">
        <div class="faq-panel">
          <h2 class="section-title section-title-secondary" id={asStr(faq?.headingId) || 'city-faq-heading'}>
            {asStr(faq?.headline) || 'Frequently Asked Questions'}
          </h2>
          <div class="faq-list" data-faq-accordion>
            {(Array.isArray(faq?.items) && faq.items.length > 0
              ? faq.items
              : [
                  {
                    question: 'How long does installation take?',
                    answerHtml: '<p>Most projects are completed in one day depending on roof size and complexity.</p>',
                  },
                ]
            ).slice(0, 8).map((item, idx) => {
              const n = idx + 1
              const btnId = `city-faq-btn-${n}`
              const panelId = `city-faq-panel-${n}`
              return (
                <div class="faq-item">
                  <button
                    type="button"
                    class="faq-summary"
                    id={btnId}
                    aria-expanded="false"
                    aria-controls={panelId}
                  >
                    <span class="faq-question">{asStr(item.question)}</span>
                    <span class="faq-chevron" aria-hidden="true"></span>
                  </button>
                  <div
                    class="faq-answer-outer"
                    id={panelId}
                    role="region"
                    aria-labelledby={btnId}
                    aria-hidden="true"
                  >
                    <div class="faq-answer" set:html={sanitizeCmsHtml(asStr(item.answerHtml))} />
                  </div>
                </div>
              )
            })}
          </div>
        </div>
      </div>
    </section>

    <section class="section google-reviews">
      <div class="container">
        <h2 class="section-title reviews-title">{asStr(reviewsToRender?.headline) || 'Customer Reviews'}</h2>
        <div class="reviews-summary">
          <div class="reviews-summary-left">
            <p class="reviews-summary-brand">
              <img
                src={mediaUrl(asStr(reviewsToRender?.summary?.googleIconSrc))}
                alt={asStr(reviewsToRender?.summary?.brandLabel)}
                class="google-logo"
              />
              <span>{asStr(reviewsToRender?.summary?.brandLabel)}</span>
            </p>
          </div>
          <a href={asStr(reviewsToRender?.summary?.ctaHref) || '/reviews/'} class="btn btn-primary reviews-summary-cta">
            {asStr(reviewsToRender?.summary?.ctaText) || 'See More Reviews'}
          </a>
        </div>
        <div class="testimonials-grid">
          {(Array.isArray(reviewsToRender?.testimonials) ? reviewsToRender.testimonials : []).slice(0, 4).map((t) => (
            <blockquote class="testimonial">
              <div class="review-brand review-brand-top">
                <img src={mediaUrl(asStr(t.avatarSrc))} alt={asStr(t.author)} class="review-avatar" />
                <div class="review-meta">
                  <strong>{asStr(t.author)}</strong>
                  <span class="review-time">{asStr(t.timeAgo)}</span>
                </div>
              </div>
              <img
                src={mediaUrl(asStr(reviewsToRender?.summary?.starsImageSrc))}
                alt={asStr(reviewsToRender?.summary?.starsImageAlt)}
                class="review-stars"
              />
              <p>&quot;{asStr(t.quote)}&quot;</p>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    {midCta ? (
      <section class="section">
        <div class="container">
          <article style="max-width: 72ch; margin: 0 auto;">
            <h2 class="section-title section-title-secondary">{asStr(midCta.headline)}</h2>
            <div
              class="section-lead city-service-body"
              style="max-width:72ch; margin-bottom: 1rem;"
              set:html={sanitizeCmsHtml(asStr(midCta.body))}
            />
            <div class="why-choose-actions" style="margin: 0;">
              <a href={`tel:${phoneTel}`} class="btn btn-primary btn-lg">{heroCallLabel}</a>
              <a href={estimateCtaHref} class="btn btn-outline btn-lg request-estimate">{estimateCtaText}</a>
            </div>
          </article>
        </div>
      </section>
    ) : null}

    <section class="section service-area" id="city-map">
      <div class="container">
        {showServiceAreaCities ? (
          <>
            <div class="why-eyebrow">{asStr(serviceArea?.eyebrow) || 'Service Area'}</div>
            <h2 class="section-title">{asStr(serviceArea?.headline) || 'Rain Gutters in the Denver Metro Area'}</h2>
            <p class="section-lead service-area-intro">{asStr(serviceArea?.intro)}</p>
            <div class="service-area-grid">
              <div class="map-wrap">
                <iframe
                  src={mapEmbedUrl}
                  width="600"
                  height="400"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title={`${companyName} service area map`}
                ></iframe>
              </div>
              <div class="cities-list">
                <p class="cities-label">{asStr(serviceArea?.citiesLabel) || 'Cities We Serve'}</p>
                <nav class="cities-nav" aria-label={asStr(serviceArea?.citiesNavAriaLabel) || 'Cities We Serve'}>
                  {(Array.isArray(serviceArea?.cities) ? serviceArea.cities : []).map((c) => (
                    <a href={asStr(c.href) || '#contact'}>{asStr(c.name)}</a>
                  ))}
                </nav>
              </div>
            </div>
          </>
        ) : (
          <div class="map-wrap" style="max-width: none; border-radius: 0; box-shadow: none; margin: 0 -1.5rem;">
            <iframe
              src={mapEmbedUrl}
              width="100%"
              height="440"
              style="border:0; display:block;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={`${companyName} service area map`}
            ></iframe>
          </div>
        )}
      </div>
    </section>
  </main>

  <footer class="footer">
    <section id="contact" class="section contact footer-estimate">
      <div class="container">
        <div class="contact-wrapper">
          <div class="contact-info">
            <h2 class="section-title">{asStr(footerEstimate?.headline) || 'Need Gutter Help in Denver?'}</h2>
            <p>{asStr(footerEstimate?.intro) || 'Placeholder contact block for the City Service page base.'}</p>
            <FooterContactInfo
              variant="estimate"
              phoneTel={phoneTel}
              phoneDisplay={phoneDisplay}
              email={email}
              address={address}
              addressHref={addressHref}
            />
          </div>
          <form
            class="contact-form"
            data-lead-form="city-footer"
            action={universalFormAction}
            method={universalFormMethod}
          >
            <div class="contact-form-grid">
              <div class="contact-form-field">
                <label for="city-footer-first-name">
                  First Name{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input id="city-footer-first-name" name="firstName" type="text" required autocomplete="given-name" />
              </div>
              <div class="contact-form-field">
                <label for="city-footer-last-name">
                  Last Name{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input id="city-footer-last-name" name="lastName" type="text" required autocomplete="family-name" />
              </div>
              <div class="contact-form-field">
                <label for="city-footer-email">
                  {asStr(universalFormFields?.emailLabel) || 'Email'}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input id="city-footer-email" name="email" type="email" required autocomplete="email" />
              </div>
              <div class="contact-form-field">
                <label for="city-footer-phone">
                  {asStr(universalFormFields?.phoneLabel) || 'Phone'}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input
                  id="city-footer-phone"
                  name="phone"
                  type="tel"
                  required
                  autocomplete="tel"
                  maxlength="12"
                  inputmode="numeric"
                  pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}"
                  title="10-digit phone, e.g. 303-762-9841"
                />
              </div>
              <div class="contact-form-field contact-form-field-full">
                <label for="city-footer-address">Address</label>
                <input
                  id="city-footer-address"
                  name="address"
                  type="text"
                  autocomplete="street-address"
                  spellcheck="false"
                />
              </div>
              <div class="contact-form-field contact-form-field-full">
                <label for="city-footer-message">{asStr(universalFormFields?.projectDetailsLabel) || 'Project Details'}</label>
                <textarea id="city-footer-message" name="message" rows="4"></textarea>
              </div>
            </div>
            <LeadFormSmsConsent idPrefix="city-footer" variant="contact" />
            <button type="submit" class="btn btn-primary btn-lg">Submit</button>
          </form>
        </div>
      </div>
    </section>
    <div class="container">
      <div class="footer-inner">
        <div class="footer-brand-block footer-col">
          {logoWhite ? <img src={mediaUrl(logoWhite)} alt={companyName} class="footer-logo" /> : null}
          <p class="footer-address">{descriptionShort}</p>
          <div class="footer-social" aria-label={asStr(footerBrand?.socialAriaLabel)}>
            {footerBrand?.socialLinks?.map((s) => (
              <a href={asStr(s.href)} aria-label={asStr(s.ariaLabel)}>
                <FooterSocialIcon platform={asStr(s.platform)} />
              </a>
            ))}
          </div>
        </div>
        {footerColumns?.map((col) => (
          <div class="footer-col">
            <p class="footer-heading">{asStr(col.heading)}</p>
            {col.links?.length ? (
              <nav class="footer-links" aria-label={asStr(col.ariaLabel)}>
                {col.links.map((link) => (
                  <a href={asStr(link.href)}>{asStr(link.label)}</a>
                ))}
              </nav>
            ) : null}
            {isContactFooterColumnHeading(col.heading) ? (
              <FooterContactInfo
                variant="footer-column"
                phoneTel={phoneTel}
                phoneDisplay={phoneDisplay}
                email={email}
                address={address}
                addressHref={addressHref}
              />
            ) : null}
            {col.hoursHeading ? <p class="footer-heading footer-hours-heading">{asStr(col.hoursHeading)}</p> : null}
            {col.hoursText ? <FooterHoursRow hoursText={col.hoursText} /> : null}
          </div>
        ))}
      </div>
    </div>
  </footer>

  <FooterSupportBar footerSupport={footerSupport} copyrightHref={copyrightHref} companyName={companyName} />
</BaseLayout>
